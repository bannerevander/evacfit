# demo = in-browser data (localStorage), works offline. supabase = real backend.
VITE_DATA_MODE=supabase
# From the EvacFit Supabase project (Settings > API). Publishable key only; never put the service_role/secret key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# OR-Tools solver service (evacfit/solver). Leave empty to use only the built-in greedy matcher.
VITE_SOLVER_URL=https://evacfit-solver.vercel.app
